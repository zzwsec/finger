-- utf-8

-- 域
domain = {{ domain | to_json }}
-- 本地地址
ip = {{ current_ip | to_json }}
-- 端口
port = {{ game_port }}
-- 地址
server = string.format("tcp://0.0.0.0:%d", port)
-- 互联互通
cluster = string.format("tcp://%s:%d", ip, port)
-- 线程数
thread = {{ thread }}
-- 日志配置
logger = "etc/server.log.ini"
-- 时间偏移量
time_offset = 0
-- 时区
time_zone = {{ time_zone }}

-- 外部地址
extern_ip = {{ extern_ip | to_json }}
-- 服务发现
discovers = {
{% for item in discovers %}
    {{ ("tcp://" ~ item.host ~ ":" ~ item.port) | to_json }},
{% endfor %}
}

game_db = {
    ["host"] = {{ game_db.host | to_json }},
    ["user"] = {{ game_db.user | to_json }},
    ["password"] = {{ game_db.password | to_json }},
    ["name"] = {{ game_db.name | to_json }},
}

-- 组编号
group_id = {{ group_id }}
-- 区域编号
area_id = {{ area_id }}

-- 游戏服务
game_index_num = {{ game_index_num }}

require("etc/services")
require("etc/zones")
require("etc/server")
