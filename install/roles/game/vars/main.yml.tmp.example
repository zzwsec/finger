domain: /p8
current_ip: ${current_ip}
game_port: ${game_port}
thread: 8
pay_notify_url: 'CHANGE_ME_PAY_NOTIFY_URL'

discovers:
  - zkip: 'CHANGE_ME_DISCOVERY_IP'
    zkport: 2881
  - zkip: 'CHANGE_ME_DISCOVERY_IP'
    zkport: 2882
  - zkip: 'CHANGE_ME_DISCOVERY_IP'
    zkport: 2883

game_db:
  db_host: 'CHANGE_ME_DB_HOST'
  db_user: 'CHANGE_ME_DB_USER'
  db_password: 'CHANGE_ME_DB_PASSWORD'
  db_name: cbt4_game_${server_num}

group_id: 1
area_id: ${server_num}
game_index_num: 2
app_binary: p8_app_server
open_time: "{{ lookup('pipe', 'date +\"%Y-%m-%dT%H:01:00\"') }}"
